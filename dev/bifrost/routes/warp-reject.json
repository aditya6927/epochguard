{
  "client": {
    "enable_logging": true,
    "enforce_auth_on_inference": false
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/route-audit/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/route-audit/logs.db"
    }
  },
  "providers": {
    "fixture": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "passthrough": {
          "allowed_routes": [
            {
              "path": "/**"
            }
          ]
        }
      },
      "network_config": {
        "base_url": "http://provider:9000",
        "allow_private_network": true,
        "max_retries": 0,
        "default_request_timeout_in_seconds": 10
      },
      "keys": [
        {
          "name": "local-fixture",
          "value": "not-a-real-secret",
          "models": [
            "epochguard-test",
            "epochguard-fallback",
            "epochguard-embed"
          ],
          "weight": 1
        }
      ]
    },
    "openai": {
      "network_config": {
        "base_url": "http://provider:9000",
        "allow_private_network": true,
        "max_retries": 0,
        "default_request_timeout_in_seconds": 10
      },
      "keys": [
        {
          "name": "local-fixture",
          "value": "not-a-real-secret",
          "models": [
            "epochguard-test",
            "epochguard-fallback",
            "epochguard-embed"
          ],
          "weight": 1
        }
      ]
    },
    "anthropic": {
      "network_config": {
        "base_url": "http://provider:9000",
        "allow_private_network": true,
        "max_retries": 0,
        "default_request_timeout_in_seconds": 10
      },
      "keys": [
        {
          "name": "local-fixture",
          "value": "not-a-real-secret",
          "models": [
            "epochguard-test",
            "epochguard-fallback",
            "epochguard-embed"
          ],
          "weight": 1
        }
      ]
    }
  },
  "plugins": [
    {
      "name": "routeobserver",
      "enabled": true,
      "path": "/app/plugins/routeobserver.so",
      "placement": "pre_builtin",
      "order": -1,
      "config": {}
    },
    {
      "name": "epochguard",
      "enabled": true,
      "path": "/app/plugins/epochguard.so",
      "placement": "pre_builtin",
      "order": 0,
      "config": {
        "test_only": true,
        "decision": "REJECT"
      }
    }
  ],
  "framework": {
    "pricing": {
      "pricing_url": "file:///app/catalogs/pricing.json",
      "model_parameters_url": "file:///app/catalogs/model-parameters.json",
      "mcp_library_url": "file:///app/catalogs/mcp-library.json",
      "mcp_library_sync_interval": 0,
      "live_models_sync_interval": 0
    }
  },
  "feature_flags": {
    "flags": {
      "warp": {
        "enabled": true
      }
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "redis",
    "config": {
      "addr": "redis:6379",
      "read_timeout": "5s",
      "context_timeout": "5s"
    }
  },
  "warp": {
    "enabled": true,
    "provider": "fixture",
    "model": "epochguard-test",
    "max_iterations": 2,
    "request_timeout_seconds": 5,
    "embedding_provider": "fixture",
    "embedding_model": "epochguard-embed",
    "embedding_dimension": 1,
    "log_vector_store_namespace": "EpochGuardRouteAudit",
    "topic_discovery_min_requests": 1000
  }
}
