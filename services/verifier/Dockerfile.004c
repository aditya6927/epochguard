# Repository-root context is required: 004B reuses the sibling 004A package.
# The original services/verifier/Dockerfile and its context remain unchanged.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONPATH=/app:/app/claims
WORKDIR /app
COPY services/verifier/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY services/verifier/verifier/ ./verifier/
COPY services/claim_analysis/claim_analysis/ ./claims/claim_analysis/
COPY services/verifier/tests_multiclaim/ ./tests_multiclaim/
COPY services/verifier/tests_gateway/ ./tests_gateway/
COPY tests/conformance/ ./conformance/
COPY services/verifier/pytest.ini ./pytest.ini
RUN python -m pytest -p no:cacheprovider tests_multiclaim tests_gateway -q
USER 10001:10001
CMD ["python", "-m", "uvicorn", "verifier.multiclaim.app:fixture_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--limit-concurrency", "32"]
